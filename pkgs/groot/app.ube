package groot

// WIT ABI bindings for host window, input, and GPU
extern "groot:engine/window@0.2.0" fn "open" host_window_open(width: i32, height: i32, title_ptr: i32, title_len: i32, vsync: i32)
extern "groot:engine/gpu@0.2.0" fn "setup" host_gpu_setup(width: i32, height: i32)
extern "groot:engine/gpu@0.2.0" fn "draw-frame" host_gpu_draw(r: f64, g: f64, b: f64)
extern "groot:engine/gpu@0.2.0" fn "submit-vertices" host_gpu_submit_vertices(ptr: i32, len: i32)

pub struct AppConfig {
    pub width: i32,
    pub height: i32,
    pub title: string,
    pub vsync: bool
}

pub fn default_config() -> AppConfig {
    return AppConfig{
        width: 1280,
        height: 720,
        title: "Groot Game Engine",
        vsync: true
    }
}

pub struct App {
    pub config: AppConfig,
    pub world: World,
    pub input: InputState,
    pub batcher: SpriteBatcher,
    pub camera: Camera2D,
    pub clear_color: Color,
    pub running: bool
}

pub fn app_new(cfg: AppConfig) -> App {
    let w = cfg.width as f32
    let h = cfg.height as f32
    return App{
        config: cfg,
        world: world_new(1024),
        input: input_new(),
        batcher: sprite_batcher_new(4096),
        camera: camera2d_new(w, h),
        clear_color: color_rgba(0.06, 0.06, 0.09, 1.0),
        running: true
    }
}

pub fn (mut app App) run() {
    let cfg = app.config
    let vsync_val = if cfg.vsync { 1 } else { 0 }
    host_window_open(cfg.width, cfg.height, cfg.title.ptr, cfg.title.len, vsync_val)
    host_gpu_setup(cfg.width, cfg.height)

    let fixed_dt: f32 = 0.016666

    // Per-iteration arena loop unwinds Tier 2 bump memory on every frame tick!
    arena while app.running {
        app.batcher.clear()

        // Batch rendering submission
        if app.batcher.vertices.len > 0 {
            host_gpu_submit_vertices(app.batcher.vertices.ptr, app.batcher.vertices.len)
        }

        let cc = app.clear_color
        host_gpu_draw(cc.r as f64, cc.g as f64, cc.b as f64)
    }
}
