package groot

pub struct Color {
    pub r: f32,
    pub g: f32,
    pub b: f32,
    pub a: f32
}

pub fn color_rgba(r: f32, g: f32, b: f32, a: f32) -> Color {
    return Color{ r: r, g: g, b: b, a: a }
}

pub fn color_rgb(r: f32, g: f32, b: f32) -> Color {
    return Color{ r: r, g: g, b: b, a: 1.0 }
}

pub fn color_white() -> Color { return color_rgba(1.0, 1.0, 1.0, 1.0) }
pub fn color_black() -> Color { return color_rgba(0.0, 0.0, 0.0, 1.0) }
pub fn color_green() -> Color { return color_rgba(0.0, 0.94, 0.46, 1.0) }
