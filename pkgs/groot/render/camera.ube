package groot

pub struct Camera2D {
    pub position: Vec2,
    pub viewport_width: f32,
    pub viewport_height: f32,
    pub zoom: f32
}

pub fn camera2d_new(viewport_width: f32, viewport_height: f32) -> Camera2D {
    return Camera2D{
        position: vec2_zero(),
        viewport_width: viewport_width,
        viewport_height: viewport_height,
        zoom: 1.0
    }
}

pub fn (c Camera2D) projection() -> Mat4 {
    let half_w = (c.viewport_width * 0.5) / c.zoom
    let half_h = (c.viewport_height * 0.5) / c.zoom
    return mat4_ortho(
        c.position.x - half_w,
        c.position.x + half_w,
        c.position.y - half_h,
        c.position.y + half_h,
        -100.0,
        100.0
    )
}
