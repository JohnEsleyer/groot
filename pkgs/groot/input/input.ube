package input

pub struct InputState {
    pub key_down_states: [256]bool,
    pub mouse_down_states: [4]bool,
    pub mouse_x: f32,
    pub mouse_y: f32
}

pub fn input_new() -> InputState {
    return InputState{
        key_down_states: [256]bool{
            false, false, false, false, false, false, false, false,
            false, false, false, false, false, false, false, false
        },
        mouse_down_states: [4]bool{false, false, false, false},
        mouse_x: 0.0,
        mouse_y: 0.0
    }
}

pub fn (view inp InputState) is_key_down(code: i32) -> bool {
    if code >= 0 && code < 256 {
        return inp.key_down_states[code]
    }
    return false
}

pub fn (view inp InputState) is_mouse_down(button: i32) -> bool {
    if button >= 0 && button < 4 {
        return inp.mouse_down_states[button]
    }
    return false
}

pub fn (mut inp InputState) on_key_event(code: i32, is_pressed: bool) {
    if code >= 0 && code < 256 {
        inp.key_down_states[code] = is_pressed
    }
}

pub fn (mut inp InputState) on_mouse_event(button: i32, is_pressed: bool) {
    if button >= 0 && button < 4 {
        inp.mouse_down_states[button] = is_pressed
    }
}

pub fn (mut inp InputState) on_mouse_move(x: f32, y: f32) {
    inp.mouse_x = x
    inp.mouse_y = y
}

// Helpers for common keys
pub fn key_space() -> i32 { return 32 }
pub fn key_enter() -> i32 { return 13 }
pub fn key_escape() -> i32 { return 27 }
pub fn key_left() -> i32 { return 37 }
pub fn key_up() -> i32 { return 38 }
pub fn key_right() -> i32 { return 39 }
pub fn key_down() -> i32 { return 40 }

// Alias and manager struct for higher-level loops
pub struct InputManager {
    pub state: InputState
}

pub fn manager_new() -> InputManager {
    return InputManager{
        state: input_new()
    }
}

pub fn (mut m InputManager) begin_frame() {
    // Reset transient frame triggers if needed
}

pub fn (mut m InputManager) feed_event(kind: i32, code: i32, x: f32, y: f32) {
    if kind == 0 {
        m.state.on_key_event(code, true)
    } else if kind == 1 {
        m.state.on_key_event(code, false)
    } else if kind == 2 {
        m.state.on_mouse_move(x, y)
    } else if kind == 3 {
        m.state.on_mouse_event(code, true)
    } else if kind == 4 {
        m.state.on_mouse_event(code, false)
    }
}

pub fn (view m InputManager) is_key_down(code: i32) -> bool {
    return m.state.is_key_down(code)
}

pub fn (view m InputManager) is_key_pressed(code: i32) -> bool {
    return m.state.is_key_down(code)
}
