package groot

pub struct World {
    pub entities: Pool[Entity],
    pub next_id: i32
}

pub fn world_new(initial_capacity: i32) -> World {
    return World{
        entities: Pool[Entity].new(initial_capacity),
        next_id: 1
    }
}

pub fn (mut w World) spawn(tag: i32, transform: Transform, color: Color) -> Handle[Entity] {
    let id = w.next_id
    w.next_id += 1
    let ent = entity_new(id, tag, transform, color)
    return w.entities.spawn(ent)
}

pub fn (mut w World) despawn(h: Handle[Entity]) {
    w.entities.despawn(h)
}
