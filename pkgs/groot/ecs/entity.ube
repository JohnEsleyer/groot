package groot

pub struct Entity {
    pub id: i32,
    pub tag: i32,
    pub active: bool,
    pub transform: Transform,
    pub color: Color
}

pub fn entity_new(id: i32, tag: i32, transform: Transform, color: Color) -> Entity {
    return Entity{
        id: id,
        tag: tag,
        active: true,
        transform: transform,
        color: color
    }
}
