package math

pub struct Vec2 {
    pub x: f32,
    pub y: f32
}

pub fn vec2(x: f32, y: f32) -> Vec2 {
    return Vec2{ x: x, y: y }
}

pub fn vec2_zero() -> Vec2 {
    return Vec2{ x: 0.0, y: 0.0 }
}

pub fn vec2_one() -> Vec2 {
    return Vec2{ x: 1.0, y: 1.0 }
}

pub fn (a Vec2) add(b: Vec2) -> Vec2 {
    return Vec2{ x: a.x + b.x, y: a.y + b.y }
}

pub fn (a Vec2) sub(b: Vec2) -> Vec2 {
    return Vec2{ x: a.x - b.x, y: a.y - b.y }
}

pub fn (a Vec2) scale(s: f32) -> Vec2 {
    return Vec2{ x: a.x * s, y: a.y * s }
}

pub fn (a Vec2) dot(b: Vec2) -> f32 {
    return a.x * b.x + a.y * b.y
}

pub fn (a Vec2) length_squared() -> f32 {
    return a.x * a.x + a.y * a.y
}
