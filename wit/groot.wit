package ube:graphics@0.2.0;

interface window {
    create-window: func(width: u32, height: u32, title: string);
}

interface gpu {
    setup: func(width: u32, height: u32);
    set-vertices: func(data: list<f32>);
    draw-frame: func(r: f64, g: f64, b: f64);
}

interface gpu3d {
    type mesh-id = u32;
    upload-mesh: func(vertices: list<f32>, indices: list<u32>) -> mesh-id;
    destroy-mesh: func(id: mesh-id);

    set-camera: func(view-proj: list<f32>, eye-pos: list<f32>);
    set-directional-light: func(dir: list<f32>, color: list<f32>, intensity: f32);

    draw-instances: func(mesh: mesh-id, instance-data: list<f32>);
    draw-frame: func(clear-r: f64, clear-g: f64, clear-b: f64);
}

interface input {
    is-key-down: func(code: u32) -> bool;
    is-mouse-down: func(button: u32) -> bool;
    mouse-x: func() -> f32;
    mouse-y: func() -> f32;
    /// Returns a compact input snapshot in a single ABI call.
    /// Layout (little-endian bytes):
    ///   [0..32]  key-words: 4×u64 bitmask for key codes 0..255
    ///            bit N of word (N/64) = key N is currently held
    ///   [32..33] mouse-buttons: u8 bitmask (bit 0=left, 1=right, 2=middle)
    ///   [33..37] mouse-x: f32
    ///   [37..41] mouse-y: f32
    get-input-snapshot: func() -> list<u8>;
}

interface trace {
    log: func(level: u8, tag: string, msg: string);
    span-begin: func(name: string);
    span-end: func();
    metric-u32: func(name: string, value: u32);
    delta-time: func() -> f32;
}

/// Manifest ABI — host exposes project configuration from groot.toml so that
/// app_new_from_manifest() can read window dimensions at runtime
/// without baking them into the .wasm binary.
interface manifest {
    manifest-width:  func() -> u32;
    manifest-height: func() -> u32;
}

world groot-runner {
    import window;
    import gpu;
    import gpu3d;
    import input;
    import trace;
    import manifest;
    include wasi:cli/command@0.2.0;
}
