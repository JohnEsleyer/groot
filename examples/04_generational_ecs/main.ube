package main

// 04 — Generational ECS: Demonstrating zero-GC entity lifecycles using Pool[Entity]

import "groot/app" as app
import "groot/ecs" as ecs
import "groot/math" as math
import "groot/color" as color
import "groot/input" as input

fn main() {
    let mut game = app::app_new(app::EngineConfig{
        width: 800,
        height: 600,
        title: "Groot — Generational ECS Example"
    })
    game.start()

    let mut world = ecs::world_new(128)

    // Spawn 5 initial sprite entities
    let mut h1 = world.create_sprite_rgba(100.0, 150.0, 32.0, 32.0, 0.9, 0.2, 0.2, 1.0)
    let mut h2 = world.create_sprite_rgba(200.0, 150.0, 32.0, 32.0, 0.2, 0.8, 0.3, 1.0)
    let mut h3 = world.create_sprite_rgba(300.0, 150.0, 32.0, 32.0, 0.2, 0.4, 0.9, 1.0)

    let mut frame = 0
    while game.is_running {
        game.begin_frame()
        if game.input.is_key_pressed(input::key_escape()) {
            game.stop()
        }

        // Periodically recycle h2 to show generational safety in an ongoing loop
        if frame % 120 == 40 {
            world.despawn(h2)
        }
        if frame % 120 == 80 {
            h2 = world.create_sprite_rgba(200.0, 250.0, 48.0, 48.0, 1.0, 0.9, 0.2, 1.0)
        }

        arena {
            // Draw active entities
            if let e1 = world.get(h1) {
                if e1.has_sprite {
                    game.draw_rect(e1.transform.position.x, e1.transform.position.y, e1.sprite.size.x, e1.sprite.size.y, e1.sprite.color)
                }
            }
            if let e2 = world.get(h2) {
                if e2.has_sprite {
                    game.draw_rect(e2.transform.position.x, e2.transform.position.y, e2.sprite.size.x, e2.sprite.size.y, e2.sprite.color)
                }
            }
            if let e3 = world.get(h3) {
                if e3.has_sprite {
                    game.draw_rect(e3.transform.position.x, e3.transform.position.y, e3.sprite.size.x, e3.sprite.size.y, e3.sprite.color)
                }
            }

            game.present()
        }

        frame += 1
    }
}
