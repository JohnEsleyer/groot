package main

import "groot/app" as app
import "groot/math" as math
import "groot/render3d" as render3d
import "groot/platform3d" as platform3d
import "groot/color" as color
import "groot/input" as input
import "groot/trace" as trace

struct LandscapeEntity {
    model: math::Mat4,
    tint:  color::Color
}

fn clamp01(v: f32) -> f32 {
    if v < 0.0 { return 0.0 }
    if v > 1.0 { return 1.0 }
    return v
}

fn main() {
    let mut game = app::app_new_from_manifest()
    game.start()

    let cube_mesh = platform3d::load_cube_mesh()
    let plane_mesh = platform3d::load_plane_mesh(160.0)

    let mut cam = render3d::Camera3D{
        position: math::vec3(0.0, 24.0, 52.0),
        target:   math::vec3(0.0, 4.0, 0.0),
        up:       math::vec3(0.0, 1.0, 0.0),
        fov_y:    0.785398,
        aspect:   1280.0 / 720.0,
        near:     0.1,
        far:      500.0
    }

    // Build mountain monoliths and landscape features
    let mut entities = []LandscapeEntity{}
    let mut x_i = -8
    while x_i <= 8 {
        let mut z_i = -8
        while z_i <= 8 {
            let mod_val = (x_i * 7 + z_i * 13) % 17
            let height = 2.0 + (if mod_val < 0 { -mod_val } else { mod_val } as f32) * 1.2
            let px = (x_i as f32) * 8.0
            let pz = (z_i as f32) * 8.0
            let py = height * 0.5

            let model = math::mat4_mul(
                math::mat4_translate(px, py, pz),
                math::mat4_scale(3.0, height, 3.0)
            )
            let base_col = color::rgba(0.55, 0.58, 0.62, 1.0)
            entities.push(LandscapeEntity{ model: move model, tint: move base_col })
            z_i += 2
        }
        x_i += 2
    }

    let mut time_of_day: f32 = 0.8
    let mut cam_angle: f32 = 0.0

    while game.is_running {
        game.begin_frame()
        if game.input.is_key_pressed(input::key_escape()) {
            game.stop()
        }

        let dt = trace::dt()
        time_of_day += dt * 0.35 // Continuous progression
        cam_angle += dt * 0.12

        cam.position.x = math::sin(cam_angle) * 58.0
        cam.position.z = math::cos(cam_angle) * 58.0

        // Calculate sun elevation
        let sun_elevation = math::sin(time_of_day)
        let sun_azimuth = math::cos(time_of_day)

        // Interpolate lighting and sky colors based on elevation
        let mut sun_dir = math::vec3(sun_azimuth, -sun_elevation, -0.4).normalized()
        let mut sun_color = color::white()
        let mut sun_intensity: f32 = 1.0
        let mut sky_r: f64 = 0.02
        let mut sky_g: f64 = 0.02
        let mut sky_b: f64 = 0.05

        if sun_elevation > 0.25 {
            // Day / Midday
            let day_ratio = clamp01((sun_elevation - 0.25) / 0.75)
            sun_color = color::lerp(color::rgba(1.0, 0.75, 0.4, 1.0), color::rgba(1.0, 0.98, 0.92, 1.0), day_ratio)
            sun_intensity = 0.8 + day_ratio * 0.4
            sky_r = 0.15 + (day_ratio as f64) * 0.15
            sky_g = 0.35 + (day_ratio as f64) * 0.25
            sky_b = 0.65 + (day_ratio as f64) * 0.25
        } else if sun_elevation > -0.15 {
            // Dawn / Dusk transition
            let twilight_ratio = clamp01((sun_elevation + 0.15) / 0.40)
            sun_color = color::lerp(color::rgba(0.2, 0.3, 0.6, 1.0), color::rgba(1.0, 0.45, 0.15, 1.0), twilight_ratio)
            sun_intensity = 0.3 + twilight_ratio * 0.5
            sky_r = 0.05 + (twilight_ratio as f64) * 0.25
            sky_g = 0.05 + (twilight_ratio as f64) * 0.15
            sky_b = 0.15 + (twilight_ratio as f64) * 0.30
        } else {
            // Night (Moonlight)
            sun_dir = math::vec3(-sun_azimuth, sun_elevation, 0.4).normalized()
            sun_color = color::rgba(0.25, 0.40, 0.75, 1.0)
            sun_intensity = 0.28
            sky_r = 0.02
            sky_g = 0.02
            sky_b = 0.05
        }

        arena {
            platform3d::set_camera(cam.view_projection(), cam.position)
            platform3d::set_directional_light(sun_dir, sun_color, sun_intensity)

            // Ground plane
            let mut ground_inst = []math::Mat4{}
            ground_inst.push(math::mat4_translate(0.0, 0.0, 0.0))
            platform3d::draw_instances(plane_mesh, ground_inst)

            // Scene monoliths
            let mut models = []math::Mat4{}
            let mut tints = []color::Color{}
            let mut i = 0
            while i < entities.len {
                models.push(entities[i].model)
                tints.push(entities[i].tint)
                i += 1
            }
            platform3d::draw_instances_tinted(cube_mesh, models, tints)

            platform3d::present(sky_r, sky_g, sky_b)
        }
    }
}
