package main

import "github.com/JohnEsleyer/groot/app" as app
import "github.com/JohnEsleyer/groot/math" as math
import "github.com/JohnEsleyer/groot/render3d" as render3d
import "github.com/JohnEsleyer/groot/platform3d" as platform3d
import "github.com/JohnEsleyer/groot/color" as color
import "github.com/JohnEsleyer/groot/input" as input
import "github.com/JohnEsleyer/groot/trace" as trace

fn main() {
    let mut game = app::app_new_from_manifest()
    game.start()

    let cube_mesh = platform3d::load_cube_mesh()
    let plane_mesh = platform3d::load_plane_mesh(60.0)

    let mut cam = render3d::Camera3D{
        position: math::vec3(0.0, 15.0, 32.0),
        target:   math::vec3(0.0, 4.0, 0.0),
        up:       math::vec3(0.0, 1.0, 0.0),
        fov_y:    0.785398,
        aspect:   1280.0 / 720.0,
        near:     0.1,
        far:      300.0
    }

    let mut t: f32 = 0.0

    while game.is_running {
        game.begin_frame()
        if game.input.is_key_pressed(input::key_escape()) {
            game.stop()
        }

        let dt = trace::dt()
        t += dt * 1.2

        // Orbit camera smoothly
        cam.position.x = math::sin(t * 0.25) * 32.0
        cam.position.z = math::cos(t * 0.25) * 32.0

        // Sweeping studio key light
        let light_x = math::sin(t)
        let light_z = math::cos(t)
        let light_dir = math::vec3(light_x, -1.2, light_z).normalized()

        // Saturated chromatic light color cycle
        let lr = 0.5 + math::sin(t * 0.7) * 0.5
        let lg = 0.5 + math::sin(t * 0.7 + 2.094) * 0.5
        let lb = 0.5 + math::sin(t * 0.7 + 4.188) * 0.5
        let light_col = color::rgba(lr, lg, lb, 1.0)

        arena {
            platform3d::set_camera(cam.view_projection(), cam.position)
            platform3d::set_directional_light(light_dir, light_col, 1.4)

            // Studio floor
            let mut ground_inst = []math::Mat4{}
            ground_inst.push(math::mat4_translate(0.0, 0.0, 0.0))
            platform3d::draw_instances(plane_mesh, ground_inst)

            let mut models = []math::Mat4{}
            let mut tints = []color::Color{}

            // Central totem sculpture: stacked twisting blocks
            let mut level = 0
            while level < 10 {
                let y = 1.0 + (level as f32) * 1.2
                let rot = math::quat_from_axis_angle(math::vec3(0.0, 1.0, 0.0), t + (level as f32) * 0.35).to_mat4()
                let scale = 3.2 - (level as f32) * 0.22
                let m = math::mat4_mul(math::mat4_translate(0.0, y, 0.0), math::mat4_mul(rot, math::mat4_scale(scale, 1.0, scale)))
                models.push(m)
                tints.push(color::rgba(0.9, 0.85, 0.75, 1.0))
                level += 1
            }

            // Outer rings of colored satellite prisms
            let mut r = 0
            while r < 16 {
                let angle = ((r as f32) / 16.0) * 6.283185
                let dist = 12.0
                let rx = math::sin(angle) * dist
                let rz = math::cos(angle) * dist
                let ry = 2.0 + math::sin(t * 2.0 + (r as f32)) * 1.5

                let rot = math::quat_from_axis_angle(math::vec3(1.0, 1.0, 0.0), t * 1.5).to_mat4()
                let m = math::mat4_mul(math::mat4_translate(rx, ry, rz), math::mat4_mul(rot, math::mat4_scale(1.2, 1.2, 1.2)))
                models.push(m)

                // Alternate hues along the ring
                if r % 2 == 0 {
                    tints.push(color::rgba(0.2, 0.85, 0.9, 1.0)) // Cyan
                } else {
                    tints.push(color::rgba(1.0, 0.3, 0.6, 1.0)) // Hot Pink
                }
                r += 1
            }

            platform3d::draw_instances_tinted(cube_mesh, models, tints)
            platform3d::present(0.03, 0.03, 0.05)
        }
    }
}
