package main

// 05 — Camera and Coordinates: World-to-screen transforms, pan, and zoom

import "groot/app" as app
import "groot/render" as render
import "groot/math" as math
import "groot/color" as color
import "groot/input" as input

fn main() {
    let mut game = app::app_new(app::EngineConfig{
        width: 800,
        height: 600,
        title: "Groot — Camera and Coordinate Transforms"
    })
    game.start()

    let mut cam = render::camera_new(800.0, 600.0)
    let target_world_pos = math::vec2(100.0, 50.0)

    let mut frame = 0
    while game.is_running {
        game.begin_frame()
        if game.input.is_key_pressed(input::key_escape()) {
            game.stop()
        }

        cam.position.x = math::sin((frame as f32) * 0.02) * 80.0
        cam.zoom = 1.2 + math::sin((frame as f32) * 0.03) * 0.4

        // Transform world coordinate into screen coordinates
        let screen_pos = cam.world_to_screen(target_world_pos)

        arena {
            // Draw target object at projected screen position
            let box_size = 40.0 * cam.zoom
            game.draw_rect(screen_pos.x, screen_pos.y, box_size, box_size, color::yellow())

            // Draw center marker
            game.draw_rect(395.0, 295.0, 10.0, 10.0, color::red())

            game.present()
        }

        frame += 1
    }
}
