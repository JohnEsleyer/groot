package main

import "../../pkgs/groot/app" as app
import "../../pkgs/groot/math" as math
import "../../pkgs/groot/render3d" as render3d
import "../../pkgs/groot/platform3d" as platform3d
import "../../pkgs/groot/color" as color

fn main() {
    let mut game = app::app_new(app::EngineConfig{
        width: 1280,
        height: 720,
        title: "Groot 3D World - Instanced Cubes"
    })
    game.start()

    let cube_mesh = platform3d::load_cube_mesh()
    let plane_mesh = platform3d::load_plane_mesh(60.0)

    let mut cam = render3d::Camera3D{
        position: math::vec3(0.0, 15.0, 30.0),
        target:   math::vec3(0.0, 0.0, -10.0),
        up:       math::vec3(0.0, 1.0, 0.0),
        fov_y:    0.785398, // 45 deg
        aspect:   1280.0 / 720.0,
        near:     0.1,
        far:      1000.0
    }

    let mut angle: f32 = 0.0
    let mut frame = 0

    while game.is_running && frame < 300 {
        angle += 0.02

        // Orbit camera around center
        cam.position.x = math::sin(angle) * 35.0
        cam.position.z = math::cos(angle) * 35.0 - 10.0

        // Transient frame setup allocated in regional scratch arena
        arena {
            platform3d::set_camera(cam.view_projection(), cam.position)
            platform3d::set_sun_light(math::vec3(-0.5, -1.0, -0.3), color::white())

            // Draw ground plane
            let mut ground_instances = []math::Mat4{}
            ground_instances.push(math::mat4_translate(0.0, -2.0, -10.0))
            platform3d::draw_instances(plane_mesh, ground_instances)

            // Build instance matrices for 100 cubes (zero persistent memory impact)
            let mut instances = []math::Mat4{}
            let mut i = 0
            while i < 100 {
                let x = ((i % 10) as f32) * 4.0 - 18.0
                let z = ((i / 10) as f32) * 4.0 - 30.0
                let y = math::sin(angle * 2.0 + (x * 0.2)) * 1.5
                instances.push(math::mat4_translate(x, y, z))
                i += 1
            }

            // Draw all cubes in 1 instanced GPU draw call
            platform3d::draw_instances(cube_mesh, instances)

            platform3d::present(0.05, 0.05, 0.08)
        } // Arena wipes the transforms instantly

        frame += 1
    }
}
