package main

import "groot/app" as app
import "groot/math" as math
import "groot/render3d" as render3d
import "groot/platform3d" as platform3d
import "groot/color" as color
import "groot/input" as input

// Builds one triangle as 3 vertices of (position, normal, uv) = 24 floats.
// Fixed arrays are copy types, so the data can be returned without an arena.
fn tri_data(view a: math::Vec3, view b: math::Vec3, view c: math::Vec3) -> [24]f32 {
    // Compute edges from field reads so the view parameters never have to be
    // moved into the Vec3 methods (views cannot be passed to owned params).
    let edge1 = math::vec3(b.x - a.x, b.y - a.y, b.z - a.z)
    let edge2 = math::vec3(c.x - a.x, c.y - a.y, c.z - a.z)
    let n = edge1.cross(edge2).normalized()

    return [24]f32{
        // Vertex A: position, normal, uv
        a.x, a.y, a.z, n.x, n.y, n.z, 0.5, 1.0,
        // Vertex B
        b.x, b.y, b.z, n.x, n.y, n.z, 0.0, 0.0,
        // Vertex C
        c.x, c.y, c.z, n.x, n.y, n.z, 1.0, 0.0
    }
}

// Builds an 8-sided double-pyramid (octahedron) with per-vertex normals and UVs
fn build_octahedron_mesh(radius: f32) -> i32 {
    let r = radius
    let mut vertices = []f32{}

    // 6 poles: +Y (top), -Y (bottom), plus 4 equatorial ring vertices.
    // Faces are generated around the equator so no vertex data is duplicated.
    let mut f = 0
    while f < 4 {
        let a0 = (f as f32) * 1.570796
        let a1 = ((f + 1) as f32) * 1.570796
        let q0 = math::vec3(math::sin(a0) * r, 0.0, math::cos(a0) * r)
        let q1 = math::vec3(math::sin(a1) * r, 0.0, math::cos(a1) * r)

        // Top pyramid face (counter-clockwise when viewed from outside)
        let top = tri_data(math::vec3(0.0, r, 0.0), q0, q1)
        let mut i = 0
        while i < 24 {
            vertices.push(top[i])
            i += 1
        }

        // Bottom pyramid face
        let bot = tri_data(math::vec3(0.0, -r, 0.0), q1, q0)
        i = 0
        while i < 24 {
            vertices.push(bot[i])
            i += 1
        }

        f += 1
    }

    let mut indices = []u32{}
    let mut i: u32 = 0
    while i < 24 {
        indices.push(i)
        i += 1
    }

    return platform3d::upload_mesh(vertices, indices)
}

fn main() {
    let mut game = app::app_new(app::EngineConfig{
        width: 1280,
        height: 720,
        title: "Groot 3D - Procedural Mesh & Quaternion Tumble"
    })
    game.start()

    let octa_mesh = build_octahedron_mesh(2.5)
    let plane_mesh = platform3d::load_plane_mesh(40.0)

    let mut cam = render3d::Camera3D{
        position: math::vec3(0.0, 8.0, 16.0),
        target:   math::vec3(0.0, 3.0, 0.0),
        up:       math::vec3(0.0, 1.0, 0.0),
        fov_y:    0.785398,
        aspect:   1280.0 / 720.0,
        near:     0.1,
        far:      500.0
    }

    let mut angle: f32 = 0.0
    let mut frame = 0

    while game.is_running {
        game.begin_frame()
        if game.input.is_key_pressed(input::key_escape()) {
            game.stop()
        }

        angle += 0.025

        arena {
            platform3d::set_camera(cam.view_projection(), cam.position)

            // Dynamic moving directional light (orbiting the scene)
            let light_dir = math::vec3(math::sin(angle), -1.2, math::cos(angle)).normalized()
            platform3d::set_directional_light(light_dir, color::white(), 1.0)

            // Ground floor
            let mut ground_inst = []math::Mat4{}
            ground_inst.push(math::mat4_translate(0.0, 0.0, 0.0))
            platform3d::draw_instances(plane_mesh, ground_inst)

            // Compose 3-axis quaternion tumble rotation
            let q_roll = math::quat_from_axis_angle(math::vec3(0.0, 1.0, 0.0), angle)
            let q_pitch = math::quat_from_axis_angle(math::vec3(1.0, 0.0, 0.0), angle * 0.7)
            let rot_mat = math::mat4_mul(q_roll.to_mat4(), q_pitch.to_mat4())

            let mut instances = []math::Mat4{}
            let mut tints = []color::Color{}

            // Center large floating gem
            let float_y = 3.5 + math::sin(angle * 1.5) * 0.5
            let center_model = math::mat4_mul(math::mat4_translate(0.0, float_y, 0.0), rot_mat)
            instances.push(center_model)
            tints.push(color::rgba(0.2, 0.9, 0.7, 1.0)) // Emerald cyan

            // Orbiting smaller octahedron gems
            let mut g = 0
            while g < 4 {
                let g_angle = angle * 1.5 + ((g as f32) * 1.570796)
                let gx = math::sin(g_angle) * 7.0
                let gz = math::cos(g_angle) * 7.0
                let gy = 2.0 + math::cos(g_angle * 2.0) * 0.8

                let g_rot = math::quat_from_axis_angle(math::vec3(0.0, 1.0, 0.0), -angle * 2.0).to_mat4()
                let g_scale = math::mat4_scale(0.5, 0.5, 0.5)
                let g_model = math::mat4_mul(math::mat4_translate(gx, gy, gz), math::mat4_mul(g_rot, g_scale))

                instances.push(g_model)
                tints.push(color::rgba(1.0, 0.4, 0.8, 1.0)) // Magenta
                g += 1
            }

            platform3d::draw_instances_tinted(octa_mesh, instances, tints)
            platform3d::present(0.06, 0.05, 0.09)
        }

        frame += 1
    }
}
