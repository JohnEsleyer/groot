package main

import "github.com/JohnEsleyer/groot/app" as app
import "github.com/JohnEsleyer/groot/color" as color
import "github.com/JohnEsleyer/groot/input" as input
import "github.com/JohnEsleyer/groot/platform" as platform

struct Bunny {
    x: f32,
    y: f32,
    vx: f32,
    vy: f32
}

fn main() {
    let mut game = app::app_new(app::EngineConfig{
        width: 1280,
        height: 720,
        title: "Groot Engine - Bunnymark Benchmark"
    })
    game.start()

    let mut bunnies = []Bunny{}
    let mut i = 0
    while i < 1000 {
        let mod_x = i % 10
        let mod_y = i % 7
        bunnies.push(Bunny{
            x: 640.0,
            y: 360.0,
            vx: (mod_x as f32) * 20.0 - 100.0,
            vy: (mod_y as f32) * 20.0 - 70.0
        })
        i += 1
    }

    let gravity: f32 = 980.0
    let dt: f32 = 0.016666

    while game.is_running {
        game.begin_frame()
        if game.input.is_key_pressed(input::key_escape()) {
            game.stop()
        }

        let mut b_idx = 0
        while b_idx < bunnies.len {
            let nx = bunnies[b_idx].x + bunnies[b_idx].vx * dt
            let ny = bunnies[b_idx].y + bunnies[b_idx].vy * dt
            let nvy = bunnies[b_idx].vy + gravity * dt
            bunnies[b_idx].x = nx
            bunnies[b_idx].y = ny
            bunnies[b_idx].vy = nvy

            if bunnies[b_idx].x < 0.0 || bunnies[b_idx].x > 1280.0 {
                let nvx = -bunnies[b_idx].vx
                bunnies[b_idx].vx = nvx
            }
            if bunnies[b_idx].y > 720.0 {
                bunnies[b_idx].y = 720.0
                let bounced_vy = -bunnies[b_idx].vy * 0.85
                bunnies[b_idx].vy = bounced_vy
            }
            b_idx += 1
        }

        // Transient frame rendering inside regional scratch arena
        arena {
            let mut draw_idx = 0
            while draw_idx < bunnies.len {
                game.draw_rect(
                    bunnies[draw_idx].x,
                    bunnies[draw_idx].y,
                    16.0,
                    16.0,
                    color::green()
                )
                draw_idx += 1
            }
            game.present()
        }
    }
}
